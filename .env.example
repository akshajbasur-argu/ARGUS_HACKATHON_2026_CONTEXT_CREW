# ── Database ──────────────────────────────────────────────────────────────────
# Uses asyncpg driver for the FastAPI app; Alembic uses psycopg2 at runtime.
DATABASE_URL=postgresql+asyncpg://grantflow:grantflow@postgres:5432/grantflow

# ── Redis / Celery ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-at-least-32-random-characters

# ── AI Integration ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=true
PROJECT_NAME=GrantFlow
