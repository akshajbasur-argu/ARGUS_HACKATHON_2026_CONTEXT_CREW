  "narrative_reasoning": "<string, max 120 words explaining the score>",
  "has_measurable_outcome": <boolean>,
  "beneficiary_specificity": "<one of: specific, vague, absent>",
  "soft_flags": [
    {
      "flag_type": "<string identifier e.g. vague_language, budget_concern>",
      "description": "<string explaining the concern>",
      "severity": "<one of: high, medium, low>"
    }
  ]
}
